{
  "manifest_version": 3,
  "name": "公众号文章监测助手",
  "version": "3.2",
  "description": "监测多个公众号的近期文章，支持自定义分类、批量下载、导出Excel",
  "permissions": [
    "cookies",
    "storage",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "*://*.weixin.qq.com/*",
    "*://*.qq.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://mp.weixin.qq.com/s*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
